# ─── Django Core ──────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=your-very-long-random-secret-key-change-this-in-production

DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=fixurdevice_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# Use 'django.core.mail.backends.console.EmailBackend' for local development
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password_not_account_password
DEFAULT_FROM_EMAIL=FixUrDevice <noreply@fixurdevice.in>
BUSINESS_EMAIL=fixurdevice.in@gmail.com

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
# Set in Next.js frontend .env.local
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Google Analytics / Ads ───────────────────────────────────────────────────
# Configure in Next.js frontend .env.local — NEVER expose in backend
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GADS_CONVERSION_ID=AW-XXXXXXXXXX
# NEXT_PUBLIC_GADS_CONVERSION_LABEL=your_label

# ─── Optional: Sentry Error Monitoring ────────────────────────────────────────
# SENTRY_DSN=https://your_key@sentry.io/your_project
